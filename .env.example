# Copy this file to .env and fill in your actual values.
# Never commit .env to Git — it is listed in .gitignore.

# Pinecone serverless vector database
# Get from: https://app.pinecone.io → API Keys
PINECONE_API_KEY=your_pinecone_api_key_here

# Groq LLM API (fast free-tier inference)
# Get from: https://console.groq.com → API Keys
GROQ_API_KEY=your_groq_api_key_here

# SEC EDGAR identity — required by edgartools before any API call
# Format: "FirstName LastName email@example.com"
# This is sent as a User-Agent header to SEC EDGAR as required by their terms of use.
EDGAR_IDENTITY=Kushal Paritala kushal.paritala@gmail.com
